{
  "name": "election-demo",
  "private": true,
  "version": "1.0.0",
  "description": "Desktop AI Meeting & Interview Copilot HUD",
  "author": "Election Team",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/hoanglong2206/Election-Demo.git"
  },
  "scripts": {
    "predev": "node -e \"const {execSync}=require('child_process');try{execSync('npx -y kill-port 5173',{stdio:'inherit'})}catch(_){}\"",
    "dev": "bun run build:electron && concurrently -k -n VITE,ELECTRON -c cyan,magenta \"bun run dev:vite\" \"bun run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 --timeout 30000 && cross-env NODE_ENV=development electron .",
    "build": "bun run build:electron && bun run build:vite",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "package": "bun run build && electron-builder --win nsis",
    "package:portable": "bun run build && electron-builder --win portable",
    "package:dir": "bun run build && electron-builder --dir",
    "release": "bun run build && electron-builder --win -p always",
    "preview": "vite preview",
    "lint": "eslint .",
    "arch:check": "bun x madge --extensions ts,tsx --ts-config tsconfig.app.json --circular src/app/ && eslint . --quiet",
    "size:report": "node scripts/size-report.cjs",
    "check": "bun run build:electron && bun x tsc -p tsconfig.app.json --noEmit && bun x tsc -p tsconfig.node.json --noEmit && bun run lint && bun test src/ && bun run build:vite",
    "ncu": "ncu",
    "ncu:update": "ncu -u && bun install",
    "ncu:minor": "ncu -u --target minor && bun install",
    "ncu:patch": "ncu -u --target patch && bun install",
    "ncu:interactive": "ncu -i",
    "deps:check": "node scripts/update-packages.cjs --check",
    "deps:update": "node scripts/update-packages.cjs --all",
    "deps:minor": "node scripts/update-packages.cjs --minor",
    "deps:patch": "node scripts/update-packages.cjs --patch",
    "deps:interactive": "ncu -i"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.12",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.3.0",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.10.2",
    "electron-builder": "^24.13.3",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "npm-check-updates": "^23.1.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.election.copilot",
    "productName": "Election AI Copilot",
    "publish": {
      "provider": "github",
      "owner": "hoanglong2206",
      "repo": "Election-Demo"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Election AI Copilot"
    }
  }
}
